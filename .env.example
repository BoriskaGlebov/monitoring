GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me

TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_CHAT_ID=change_me

# Имя этого сервера — обязательно своё на каждом хосте (попадает в лейбл
# nodename метрик node_exporter)
NODE_HOSTNAME=change_me

# Публичный домен, через который открывается Grafana (за общим edge-nginx,
# см. boriska_guard_infra/roles/nginx_edge) — используется в GF_SERVER_ROOT_URL
GRAFANA_DOMAIN=grafana.boris-guard.space

# На сервере, где живёт Prometheus (сейчас boris-guard.space:) — оставить 127.0.0.1,
# Prometheus достаёт метрики через внутреннюю docker-сеть, наружу светить незачем.
# На остальных серверах-агентах — сменить на 0.0.0.0, чтобы центральный Prometheus
# мог их скрейпить по сети (после этого доступ ограничивается файрволом по IP
# Prometheus-сервера, см. README).
CADVISOR_BIND=127.0.0.1
NODE_EXPORTER_BIND=127.0.0.1
