discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // amnezia-* контейнеры подняты с logging driver "none" (осознанно, логи VPN-подключений
  // нигде не хранятся) — Alloy не может их прочитать в принципе, оставлять в целях
  // не имеет смысла, только шлёт одну и ту же ошибку каждые 5 секунд.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(amnezia.*)"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {"job" = "docker", "server" = "boris-guard.space"}
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
